{
  "name": "paper-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local LaTeX editor with live PDF preview and an AI agent (Claude Code) working on the same files",
  "bin": {
    "paper-assistant": "bin/paper-assistant.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.ts ${PAPER:-examples/sample} --no-open\" \"vite\"",
    "build": "vite build && tsc -p server/tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node bin/paper-assistant.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "chokidar": "^6.0.0",
    "codemirror": "^6.0.2",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "files": [
    "bin",
    "dist",
    "dist-server",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  }
}
